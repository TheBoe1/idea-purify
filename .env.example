# 复制到 .env.local；只填写本机数据库账号，不提交真实密码。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=idea_purify
DB_PASSWORD=replace-with-your-local-password
DB_NAME=Ideasource
PORT=3000

# 用于生成邮箱验证和密码重设链接；不用于校验请求来源。
APP_ORIGIN=http://127.0.0.1:5173
# 使用 node -e "console.log(require('crypto').randomBytes(32).toString('hex'))" 生成。
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_SECONDS=3600
# 生产环境使用 HTTPS 并设为 true。
COOKIE_SECURE=false

# 可选邮箱注册需要验证邮件；密码恢复只发给已验证邮箱。
# 465 通常使用 SMTP_SECURE=true；587 使用 false + 强制 STARTTLS。
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# 仅在主动执行 npm run mail:check -- --send 时发送测试信。
MAIL_TEST_TO=

# 仅在执行本机管理员创建命令时填写，不会成为公开注册默认账号。
ADMIN_USERNAME=
ADMIN_PASSWORD=
